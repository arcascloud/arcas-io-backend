# ===== Configuracion del Servidor =====
PORT=3000
NODE_ENV=development

# ===== Base de Datos MySQL =====
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}

# ===== JWT =====
JWT_SECRET=${seed}
JWT_EXPIRES_IN=${JWT_EXPIRES_IN}

# ===== CORS =====
CORS_ORIGIN=${CORS_ORIGIN}

# ===== Correo =====
# ===== SMTP (correo) =====
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
MAIL_FROM=${MAIL_FROM}

# ===== TodoPago (pasarela de pagos Honduras) =====
# Solicitar credenciales en https://todopago.hn/tp-business/
TODOPAGO_MERCHANT_ID=
TODOPAGO_API_KEY=
TODOPAGO_SECURITY=
# Endpoints (dejar por defecto si usan los estándar de TodoPago)
TODOPAGO_ENDPOINT_SAR=${TODOPAGO}
TODOPAGO_ENDPOINT_GAA=${TODOPAGO}
TODOPAGO_ENDPOINT_STATUS=${TODOPAGO}
# URL pública para callbacks (si no se define, usa PUBLIC_URL)
PUBLIC_URL=http://localhost:4200
TODOPAGO_URL_OK=
TODOPAGO_URL_ERROR=
TODOPAGO_TIMEOUT=15000

# ===== OpenAI (chatbot IA) =====
# API key del servidor (nunca va al frontend). Obtener en https://platform.openai.com/api-keys
# Si está vacía, el endpoint responde que el asistente no está configurado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
# Límites del chat
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_HISTORY_MESSAGES=20
# Rate limiting: ventana en ms y máx de peticiones por usuario dentro de la ventana
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=15

VALIDAR_SESSION=n