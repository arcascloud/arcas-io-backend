# ===== Configuracion del Servidor =====
PORT=3000
NODE_ENV=development

# ===== Base de Datos MySQL =====
DB_HOST=${arcas_host}
DB_PORT=${arcas_port}
DB_USER=${arcas_user}
DB_PASSWORD=${arcas_password}
DB_NAME=${arcas_database}

# ===== JWT =====
JWT_SECRET=${seed}
JWT_EXPIRES_IN=8h

# ===== CORS =====
CORS_ORIGIN=http://localhost:4200

# ===== Correo =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
